  "info": {
    "title": "ClinicalTrials.gov Query-to-Visualization Agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/trials/{nct_id}": {
      "get": {
        "description": "The cached record behind a citation, for the frontend's record viewer. Read-only: it never\ncalls ClinicalTrials.gov, so it shows the record the excerpt check ran against.",
        "operationId": "stored_trial_api_trials__nct_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "nct_id",
            "required": true,
            "schema": {
              "pattern": "^NCT\\d{8}$",
              "title": "Nct Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredTrial"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "The trial is not in the cache"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stored Trial"
      }
    },
    "/api/visualize": {
      "post": {
        "operationId": "visualize_api_visualize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisualizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "clarification_needed": "#/components/schemas/ClarificationResponse",
                      "degraded": "#/components/schemas/DegradedResponse",
                      "no_results": "#/components/schemas/NoResultsResponse",
                      "ok": "#/components/schemas/OkResponse"
                    },
                    "propertyName": "status"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OkResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ClarificationResponse"
                    },
                    {
                      "$ref": "#/components/schemas/NoResultsResponse"
                    },
                    {
                      "$ref": "#/components/schemas/DegradedResponse"
                    }
                  ],
                  "title": "Response Visualize Api Visualize Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "ClinicalTrials.gov or the LLM failed"
          }
        },
        "summary": "Visualize"
      }
    }
  },
  "x-checks": [
    {
      "name": "schema",
      "rule": "The response matches the documented schema."
    },
    {
      "name": "encoding",
      "rule": "Every field the chart encodes exists in every row."
    },
    {
      "name": "shape",
      "rule": "The chart type fits the shape of the data."
    },
    {
      "name": "citation ids",
      "rule": "Every cited trial is in its datum and in the retrieved records."
    },
    {
      "name": "excerpts",
      "rule": "Every excerpt is the exact text at its field in the trial's record."
    },
    {
      "name": "reconciliation",
      "rule": "Each count equals its distinct trials; totals reconcile with the records."
    },
    {
      "name": "assumptions",
      "rule": "Every inferred filter is disclosed as an assumption."
    },
    {
      "name": "title",
      "rule": "The title contains no number that is not in the filters."
    },
    {
      "name": "disclosures",
      "rule": "Sample caps, pruning and top-N limits are disclosed consistently."
    },
    {
      "name": "conformance",
      "rule": "Every charted trial meets each exact filter; the filters shown are those sent."
    }
  ]
}
