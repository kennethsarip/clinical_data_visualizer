# Copy to .env and fill in. app/config.py reads exactly these (enforced by tests/test_config.py).

# Required
OPENAI_API_KEY=
OPENAI_MODEL=
# Matches docker-compose.yml: postgresql://cheiron:cheiron@127.0.0.1:5432/cheiron
DATABASE_URL=

# Optional; leave blank to use the defaults in app/config.py
CTGOV_BASE_URL=
FETCH_CAP=
CACHE_TTL_HOURS=
